# Copy to .env and fill in from Supabase: Project Settings → API (or the Connect button).
# The publishable (anon) key is safe to ship in the website; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
